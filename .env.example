# Copy this file to .env and replace only placeholder values.
POSTGRES_DB=edutool
POSTGRES_USER=edutool
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://edutool:change-me@postgres:5432/edutool
REDIS_URL=redis://redis:6379/0
SESSION_SECRET=replace-with-a-long-random-secret
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=google/gemini-2.5-flash
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=edutool-minio
S3_SECRET_KEY=change-me
S3_BUCKET=edutool-documents
MINIO_ROOT_USER=edutool-minio
MINIO_ROOT_PASSWORD=change-me
VITE_API_URL=http://localhost:8000/api/v1
